# Local defaults. For public deployment, set these explicitly to the intended
# public domain and make sure DATABASE_URL points at the intended production DB.
PUBLIC_BASE_URL=http://localhost:4007
PUBLIC_BACKEND_URL=http://localhost:4007/api
DATABASE_URL=postgresql://postiz-user:postiz-password@postiz-postgres:5432/postiz-db-local
SKIP_PRISMA_DB_PUSH=false
# Required only for a deliberate, reviewed exception.
ALLOW_PUBLIC_DOMAIN_WITH_LOCAL_DB=false
# Required only if intentionally running Prisma db push in public-domain mode.
RUN_PRISMA_DB_PUSH_IN_PUBLIC_MODE=false
DISABLE_POSTIZ_MCP=false
OPENAI_APP_CHALLANGE=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
JWT_SECRET=
OPENAI_API_KEY=

# Optional email delivery. Leave blank to keep email disabled/no-op.
# To enable Resend, set EMAIL_PROVIDER=resend, choose a sender name, use a
# Resend-verified sender address, and set RESEND_API_KEY to a real key locally.
# Never commit a real API key.
EMAIL_PROVIDER=
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_PASS=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
X_API_KEY=
X_API_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Only used with: docker compose --profile public-tunnel up -d cloudflared
CLOUDFLARED_CREDENTIALS_FILE=/path/to/.cloudflared/your-tunnel-credentials.json
