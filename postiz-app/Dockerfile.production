FROM node:22.20-bookworm-slim AS builder

ARG NEXT_PUBLIC_VERSION
ARG NEXT_PUBLIC_GUIDED_COMPOSER_SHELL=false
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_GUIDED_COMPOSER_SHELL=$NEXT_PUBLIC_GUIDED_COMPOSER_SHELL

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
 && rm -rf /var/lib/apt/lists/*

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1

WORKDIR /app

# Cache dependency installation until a manifest or the Prisma schema changes.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/commands/package.json ./apps/commands/package.json
COPY apps/extension/package.json ./apps/extension/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY apps/orchestrator/package.json ./apps/orchestrator/package.json
COPY apps/sdk/package.json ./apps/sdk/package.json
COPY libraries/nestjs-libraries/src/database/prisma/schema.prisma ./libraries/nestjs-libraries/src/database/prisma/schema.prisma

RUN pnpm install --frozen-lockfile \
 && rm -rf /root/.local/share/pnpm/store

COPY . /app

RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build \
 && rm -rf apps/frontend/.next/cache \
 && find apps/backend/dist apps/orchestrator/dist -type f \
      \( -name '*.d.ts' -o -name '*.tsbuildinfo' \) -delete

FROM node:22.20-bookworm-slim AS runtime-base

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    nginx \
 && rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www /uploads /config \
 && chown -R www:www /www /var/lib/nginx /var/log/nginx

RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 \
 && npm cache clean --force

WORKDIR /app

FROM runtime-base AS production-dependencies

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/commands/package.json ./apps/commands/package.json
COPY apps/extension/package.json ./apps/extension/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY apps/orchestrator/package.json ./apps/orchestrator/package.json
COPY apps/sdk/package.json ./apps/sdk/package.json
COPY libraries/nestjs-libraries/src/database/prisma/schema.prisma ./libraries/nestjs-libraries/src/database/prisma/schema.prisma

# Inherit this production tree in the runtime instead of copying it again.
RUN pnpm install --prod --frozen-lockfile \
 && rm -rf /root/.local/share/pnpm/store

FROM production-dependencies AS runtime

ENV NODE_ENV=production

COPY --from=builder /app/apps/frontend/next.config.js ./apps/frontend/next.config.js
COPY --from=builder /app/apps/frontend/public ./apps/frontend/public
COPY --from=builder /app/apps/frontend/.next ./apps/frontend/.next

COPY --from=builder /app/apps/backend/dist ./apps/backend/dist

COPY --from=builder /app/apps/orchestrator/dist ./apps/orchestrator/dist

COPY --from=builder /app/libraries/nestjs-libraries/src/database/prisma/migrations ./libraries/nestjs-libraries/src/database/prisma/migrations
COPY --from=builder /app/var/docker/nginx.conf /etc/nginx/nginx.conf

VOLUME ["/config", "/uploads"]
EXPOSE 5000

# Production Compose supplies the reviewed repository-level startup script.
CMD ["/bin/sh", "/start-postiz.sh"]

FROM runtime AS verification

COPY --from=builder /app/var/docker/verify-production-runtime.sh /tmp/verify-production-runtime.sh
RUN /tmp/verify-production-runtime.sh \
 && rm /tmp/verify-production-runtime.sh

# Keep the default and published result identical to the reviewed runtime stage.
FROM runtime AS production
